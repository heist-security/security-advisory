SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Use a model supporting Responses structured outputs. Pin a model snapshot for evaluation.
OPENAI_MODEL=
# Optional; use none for the production gpt-6-luna extraction candidate.
OPENAI_REASONING_EFFORT=
# Generate with: openssl rand -hex 32
CRON_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
POLL_BATCH_SIZE=12
POLL_CONCURRENCY=4
COLLECT_BATCH_SIZE=60
COLLECT_CONCURRENCY=4
PROCESS_BATCH_SIZE=24
PROCESS_CONCURRENCY=4
# Shared across overlapping workers; limits attempts, not currency spend.
EXTRACTION_HOURLY_LIMIT=60
MAX_QUEUE_AGE_SECONDS=3600

# Structured ingestion does not require OpenAI. Vendor LLM extraction is opt-in.
# Set to all for every publisher, or comma-separated exact registry IDs.
# Empty disables vendor extraction. Configure only in Production, never inherit in Preview.
VENDOR_SOURCE_IDS=
STRUCTURED_PROCESS_BATCH_SIZE=120
