{
  "name": "heist-feed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sources:verify": "node --import tsx scripts/verify-sources.ts",
    "sources:build": "node --import tsx scripts/build-registry.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate.ts",
    "sources:configure": "node --env-file-if-exists=.env.local --import tsx scripts/configure-sources.ts",
    "sources:recollect-osv": "node --env-file-if-exists=.env.local --import tsx scripts/recollect-osv.ts",
    "sources:verify-structured": "node --import tsx scripts/verify-structured.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:release",
    "test:release": "node --test tests/deployment.test.mjs",
    "feed:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-feed.ts"
  },
  "dependencies": {
    "@pandatix/js-cvss": "0.4.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
