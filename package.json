{
  "name": "heist-feed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sources:verify": "node --import tsx scripts/verify-sources.ts",
    "sources:build": "node --import tsx scripts/build-registry.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate.ts",
    "sources:configure": "node --env-file-if-exists=.env.local --import tsx scripts/configure-sources.ts",
    "sources:verify-structured": "node --import tsx scripts/verify-structured.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "cheerio": "^1.2.0",
    "next": "16.4.3",
    "openai": "^7.39.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "prettier": "3.9.10",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
